{
  "manifest_version": 3,
  "name": "Suarlog AI - Live Meeting Monitor & Telegram Sync",
  "version": "1.0.0",
  "description": "Monitor live web meetings (Google Meet, Zoom Web, Teams), capture slides, speech-to-text verbatim transcript, AI analysis & instant Telegram Bot dispatch.",
  "permissions": [
    "activeTab",
    "tabCapture",
    "storage",
    "notifications"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "*://meet.google.com/*",
        "*://*.zoom.us/*",
        "*://teams.microsoft.com/*",
        "*://teams.live.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
